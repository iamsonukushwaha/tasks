========================= */

.whatsapp{
    position:fixed;
    right:20px;
    bottom:20px;
    z-index:2000;
    width:54px;
    height:54px;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:#dce9df;
    color:#102018;
    font-size:12px;
    font-weight:900;
    box-shadow:0 10px 30px rgba(0,0,0,.2);
}


/* =========================
   MOBILE
========================= */

@media(max-width:800px){

    .container{
        width:calc(100% - 28px);
    }

    .menu{
        display:block;
    }

    .nav-links{
        position:absolute;
        top:70px;
        left:14px;
        right:14px;
        padding:20px;
        background:#0b1014;
        display:none;
        flex-direction:column;
        border:1px solid rgba(255,255,255,.1);
    }

    .nav-links.active{
        display:flex;
    }

    .nav-call{
        display:none;
    }

    .hero{
        min-height:88vh;
    }

    .hero h1{
        font-size:48px;
    }

    .section{
        padding:80px 0;
    }

    .stats-grid{
        grid-template-columns:1fr 1fr;
    }

    .section-header,
    .brand-layout,
    .about-grid,
    .contact-layout{
        grid-template-columns:1fr;
        gap:30px;
    }

    .product-grid{
        grid-template-columns:1fr;
        grid-template-rows:420px 320px 320px;
    }

    .product-card.large{
        grid-row:auto;
    }

    .gallery{
        grid-template-columns:1fr 1fr;
    }

    .location-layout{
        display:grid;
        grid-template-columns:1fr;
        gap:30px;
    }

    .footer-grid{
        grid-template-columns:1fr;
    }
}


@media(max-width:480px){

    .stats-grid{
        grid-template-columns:1fr;
    }

    .stat{
        border-right:0;
        border-bottom:1px solid rgba(255,255,255,.1);
    }

    .hero h1{
        font-size:42px;
    }

    .hero-description{
        font-size:15px;
    }

    .gallery{
        grid-template-columns:1fr;
    }

    .product-grid{
        grid-template-rows:390px 300px 300px;
    }

    .contact-row a{
        font-size:13px;
    }
}

